# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed CORS origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# URL of the frontend — used in invite emails and QR code payloads
PLATFORM_URL=https://faithcare-web.vercel.app

# ── Database ────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/faithcare

# ── JWT ─────────────────────────────────────────────────────────────────────────
# Access token (short-lived, default 8h)
ACCESS_SECRET=change-me-access-secret-in-production
JWT_ACCESS_TOKEN_EXPIRES_IN=8h

# Refresh token (long-lived, default 30d)
REFRESH_SECRET=change-me-refresh-secret-in-production
JWT_REFRESH_TOKEN_EXPIRES_IN=30d

# Admin invite link token (optional — falls back to ACCESS_SECRET if not set)
JWT_INVITE_SECRET=change-me-invite-secret-in-production
JWT_INVITE_EXPIRES_IN=7d

# First-timer QR code token — expires after one service window
# Admin regenerates the QR before each service; old codes stop working after expiry
JWT_QR_SECRET=change-me-qr-secret-in-production
JWT_QR_EXPIRES_IN=8h

# ── Email (SMTP) ────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=FaithCare <noreply@faithcare.app>

# ── Google Sign-In (client-side OAuth) ─────────────────────────────────────────
# Only the Client ID is needed — the frontend obtains the id_token and posts it
# to POST /auth/google/signin; the server verifies it using this Client ID.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── Termii SMS ──────────────────────────────────────────────────────────────────
# API key from https://app.termii.com → Settings → API Key & Webhook
TERMII_API_KEY=your-termii-api-key
# Approved alphanumeric sender ID (must be approved in your Termii dashboard)
TERMII_SENDER_ID=FaithCare
# Leave blank to use the default; only change if you have a custom endpoint
TERMII_BASE_URL=https://api.ng.termii.com/api

# ── Bible API (api.bible / scripture.api.bible) ─────────────────────────────────
# API key from https://scripture.api.bible → My Apps → API Key
API_BIBLE_KEY=your-api-bible-key
# Base URL — leave at default unless the API releases a new version
API_BIBLE_URL=https://api.scripture.api.bible/v1
# Comma-separated api.bible Bible IDs for each translation you have enabled.
# Find each ID by opening https://scripture.api.bible → My Apps → select your app
# → Enabled Bibles → copy the ID shown next to each translation.
# The free plan blocks GET /bibles (403), so IDs must be configured manually here.
API_BIBLE_IDS=de4e12af7f28f599-02,65eec8e0b60e656b-01,116FNN3PTQQH
# Display names in the same comma-separated order as API_BIBLE_IDS
API_BIBLE_NAMES=KJV,NIV,NLT

# ── AI Reflections (Anthropic Claude) ───────────────────────────────────────────
# Used to generate devotional reflections per Bible chapter (cached after first gen)
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Scripture Memorization ───────────────────────────────────────────────────────
# Uses the same API_BIBLE_KEY above. No additional key required.
# Public-domain translations cached (KJV, ASV, WEB). Copyright translations (ESV,
# NIV, NLT) are fetched live and never stored.

# ── WhatsApp (via Termii — same credentials as SMS above) ───────────────────────
# WhatsApp is sent via Termii's channel:whatsapp — no separate Meta registration needed.
# Uses TERMII_API_KEY and TERMII_SENDER_ID defined in the Termii SMS section above.
# Your Termii sender ID must be WhatsApp-enabled in the Termii dashboard.
#
# ── WhatsApp (Meta Cloud API — preserved, not active) ───────────────────────────
# Uncomment and populate these if you switch back to the direct Meta implementation.
# WHATSAPP_TOKEN=your-meta-whatsapp-access-token
# WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
# WHATSAPP_VERIFY_TOKEN=your-whatsapp-webhook-verify-token
